# Copiá este archivo como .env y completá los valores.

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=centro_medico
DB_USER=app_user
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# --- Servidor Flask ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true
TIMEZONE=America/Argentina/Buenos_Aires

# --- Seguridad ---
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=60

# --- SMTP para comprobantes ---
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DEFAULT_SENDER=no-reply@saludintegral.local
PUBLIC_BASE_URL=http://localhost:5000
# Debe cubrir el tiempo entre la reserva y el límite de cancelación (24 h antes del turno).
CANCELACION_TTL_MINUTES=86400
INTERVALO_AUSENTISMO_SEGUNDOS=300